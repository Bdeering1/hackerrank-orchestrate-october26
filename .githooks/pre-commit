#!/bin/sh
# git exports GIT_DIR to hooks in linked worktrees, which makes cwd the work tree root
export GIT_WORK_TREE="$PWD"
cd code || exit 1

staged_python_files() {
    git diff --cached --name-only --relative -z --diff-filter=ACMR -- '*.py' '*.pyi'
}

git diff --cached --quiet --diff-filter=ACMR -- '*.py' '*.pyi' && exit 0

status=0
staged_python_files |
    xargs -0 uv run --frozen ruff check --force-exclude -- || status=1
staged_python_files |
    xargs -0 uv run --frozen ruff format --check --force-exclude -- || status=1
staged_python_files |
    xargs -0 uv run --frozen basedpyright || status=1
exit "$status"
